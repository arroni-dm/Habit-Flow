# GEMINI_API_KEY: Optional. Enables AI Insights on the server.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GMAIL_USER & GMAIL_APP_PASSWORD: Sends real 6-digit password reset codes straight to Gmail / email inboxes.
# How to get GMAIL_APP_PASSWORD (takes 30 seconds):
# 1. Go to https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled on your Google account)
# 2. Create an App Password named "HabitFlow" and paste the 16-character password below (spaces are handled automatically).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Alternative email providers (optional if GMAIL_USER + GMAIL_APP_PASSWORD are not used):
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# APP_URL: Base URL where this application is hosted.
APP_URL="http://localhost:3000"

# VITE_APP_NAME: Configurable product brand name displayed across the UI and exports.
VITE_APP_NAME="HabitFlow"

# DATABASE_URL: Optional external PostgreSQL connection URI (e.g. Neon / Supabase / Cloud SQL).
# When unset in preview environments, HabitFlow persists to embedded PostgreSQL in ./data/pgdata.
DATABASE_URL=""

# PGDATA_DIR: Directory for embedded persistent PostgreSQL storage when DATABASE_URL is unset.
PGDATA_DIR="./data/pgdata"

# SESSION_SECRET: Secret salt for session and token hashing (override in production).
SESSION_SECRET="replace-with-strong-random-secret-in-production"
